<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Botão Mágico</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
            transition: background 0.5s ease;
        }

        .container {
            text-align: center;
        }

        button {
            padding: 15px 30px;
            font-size: 18px;
            cursor: pointer;
            border: none;
            border-radius: 8px;
            background-color: #333;
            color: white;
            transition: transform 0.2s;
        }

        button:hover {
            transform: scale(1.05);
        }

        .mensagem {
            display: none;
            font-size: 32px;
            color: white;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            margin-bottom: 20px;
        }

        .voltar {
            display: none;
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 14px;
            cursor: pointer;
            background-color: white;
            color: #333;
            border: none;
            border-radius: 5px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div id="mensagem" class="mensagem">vc apertou o botao</div>
        <button id="meuBotao" onclick="mudarTela()">Clique aqui</button>
        <button id="botaoVoltar" class="voltar" onclick="resetarTela()">Voltar</button>
    </div>

    <script>
        function mudarTela() {
            // Muda o fundo para um gradiente de azul e vermelho
            document.body.style.background = "linear-gradient(135deg, #0056b3, #d90429)";
            
            // Esconde o botão inicial
            document.getElementById('meuBotao').style.display = 'none';
            
            // Mostra a frase e o botão de voltar
            document.getElementById('mensagem').style.display = 'block';
            document.getElementById('botaoVoltar').style.display = 'inline-block';
        }

        function resetarTela() {
            // Volta ao estado original
            document.body.style.background = '#f0f0f0';
            document.getElementById('meuBotao').style.display = 'inline-block';
            document.getElementById('mensagem').style.display = 'none';
            document.getElementById('botaoVoltar').style.display = 'none';
        }
    </script>

</body>
</html>
